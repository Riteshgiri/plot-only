{
  "manifest_version": 3,
  "name": "Plot Only — skip the filler",
  "short_name": "Plot Only",
  "version": "1.0.2",
  "description": "Watch only the scenes that move the story. AI reads the dialogue and scenes, then skips recaps, filler and side plots on Netflix.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.nflxvideo.net/*",
    "https://*.nflxso.net/*",
    "https://plot-only-api.riteshpgiri.workers.dev/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["bridge.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plot Only",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
